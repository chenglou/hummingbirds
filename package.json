{
  "name": "net-meta-harness",
  "private": true,
  "type": "module",
  "scripts": {
    "net": "bun run src/cli.ts",
    "codex-pool": "bun run src/codex-pool.ts",
    "resident-pool": "bun run src/resident-pool.ts",
    "test": "bun test",
    "typecheck": "bun tsc --noEmit && bun tsc --noEmit -p tsconfig.experiments.json",
