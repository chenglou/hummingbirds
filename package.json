{
  "name": "@chenglou/hummingbirds",
  "version": "0.1.0",
  "description": "A decentralized flock of agents that discover peers, exchange knowledge, and create new birds.",
  "license": "MIT",
  "author": "Cheng Lou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenglou/hummingbirds.git"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "birds": "src/cli.ts"
  },
  "files": ["src"],
  "scripts": {
    "birds": "bun run src/cli.ts",
    "start": "bun run src/cli.ts start",
    "chat": "bun run src/cli.ts chat",
    "test": "bun test ./tests",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src tests experiments",
    "knip": "knip",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@openai/codex": "0.149.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "knip": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "typescript": "5.9.3"
  }
}
